# ---- core ----
DATABASE_URL="postgresql://studio:studio@localhost:5433/aistudio?schema=public"
REDIS_URL="redis://localhost:6380"
# 32+ random chars; encrypts provider API keys at rest. openssl rand -hex 32
APP_SECRET="change-me-to-a-long-random-string-please-0123456789"

# ---- media storage ----
# local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./data/media"
# only for STORAGE_DRIVER=s3 (MinIO or real S3)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="ai-studio"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# ---- provider keys (optional: can also be pasted in the Settings UI) ----
# Kling: "accessKey:secretKey" from https://app.klingai.com -> API management
KLING_API_KEY=""
KLING_BASE_URL="https://api-singapore.klingai.com"
ELEVENLABS_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_API_KEY=""
MINIMAX_API_KEY=""
MINIMAX_GROUP_ID=""
RUNWAY_API_KEY=""
BFL_API_KEY=""
